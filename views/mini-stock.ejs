<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mini Stock FSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" href="/images/storage.png" sizes="32x32">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    .table thead th { vertical-align: middle; white-space: nowrap; }
    .fse-tag { display: inline-flex; align-items: center; gap: 5px; font-size: .82rem; font-weight: 500; color: #333; }
    .fse-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .pending-badge { font-size: .72rem; }
    .shelf-low { color: #dc3545; font-weight: 600; }
    .shelf-ok { color: #198754; }
  </style>
</head>
<body>

<!-- ─── Transfer Modal ─────────────────────────────────────────── -->
<div class="modal fade" id="transferModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-arrow-right-circle me-2"></i>โอนจาก Shelf → FSE</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="transferAlert"></div>
        <div class="mb-3">
          <label class="form-label fw-bold">FSE (ช่าง)</label>
          <select id="tfFSE" class="form-select">
            <option value="">-- เลือก FSE --</option>
            <% fses.forEach(f => { %>
              <option value="<%= f.shortName %>"><%= f.shortName %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">SKU</label>
          <select id="tfSKU" class="form-select">
            <option value="">-- เลือก SKU --</option>
            <% products.forEach(p => { %>
              <option value="<%= p.sku %>" data-desc="<%= p.description %>" data-shelf="<%= p.quantity %>">
                <%= p.sku %> — <%= p.description.length > 40 ? p.description.substring(0,40)+'…' : p.description %>
              </option>
            <% }) %>
          </select>
        </div>
        <div id="tfShelfInfo" class="text-muted small mb-3"></div>
        <div class="mb-3">
          <label class="form-label fw-bold">จำนวน</label>
          <input type="number" id="tfQty" class="form-control" min="1" value="1">
        </div>
        <div class="mb-2">
          <label class="form-label">Note (ไม่จำเป็น)</label>
          <input type="text" id="tfNote" class="form-control" placeholder="หมายเหตุ">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button class="btn btn-primary" id="btnTransferSave">บันทึก</button>
      </div>
    </div>
  </div>
</div>

<!-- ─── Replenish Confirm Modal ─────────────────────────────────── -->
<div class="modal fade" id="replenishModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-arrow-repeat me-2"></i>ยืนยันการ Replenish</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3 text-muted small">ระบบจะหักสต็อก <strong>Shelf</strong> และโอนกลับเข้า Mini Stock ของ FSE</p>
        <table class="table table-sm table-bordered mb-0">
          <tbody>
            <tr>
              <th class="table-light text-nowrap" style="width:35%">FSE</th>
              <td id="rpFSE" class="fw-semibold"></td>
            </tr>
            <tr>
              <th class="table-light">SKU</th>
              <td id="rpSKU" class="font-monospace"></td>
            </tr>
            <tr>
              <th class="table-light">Description</th>
              <td id="rpDesc" class="text-muted small"></td>
            </tr>
            <tr>
              <th class="table-light">จำนวน</th>
              <td><span id="rpQty" class="badge bg-warning text-dark fs-6"></span> ชิ้น</td>
            </tr>
            <tr>
              <th class="table-light">Work Order</th>
              <td id="rpWO" class="font-monospace small"></td>
            </tr>
            <tr>
              <th class="table-light">On Shelf</th>
              <td><span id="rpShelf"></span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button class="btn btn-success" id="btnReplenishConfirm">
          <i class="bi bi-check-circle me-1"></i> ยืนยัน Replenish
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ─── Main Layout ────────────────────────────────────────────── -->
<div class="container-fluid">
  <div class="row">
    <div class="desktop-sidebar col-lg-2 col-12 d-none d-lg-block">
      <%- include('sidebar') %>
    </div>
    <%- include('sidebarMobile') %>

    <div class="col-lg-10 col-12">
      <h2 class="text-center p-4">
        Mini Stock FSE
        <img src="/images/storage.png" alt="logo" class="img-fluid" style="max-width:40px; vertical-align:middle">
      </h2>

      <div id="alertWrap" class="px-3 mb-2"></div>

      <!-- Action buttons -->
      <div class="px-3 mb-3 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#transferModal">
          <i class="bi bi-arrow-right-circle me-1"></i> โอนจาก Shelf → FSE
        </button>
        <a href="/trans-out" class="btn btn-outline-secondary">
          <i class="bi bi-box-arrow-up me-1"></i> ไปหน้า Issue Parts
        </a>
      </div>
      <p class="px-3 text-muted small">การใช้ของจาก Mini Stock ให้บันทึกผ่านหน้า <strong>Issue Parts</strong> โดยเลือก Source เป็น "Mini Stock"</p>

      <!-- Tabs -->
      <ul class="nav nav-tabs px-3" id="mainTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#balanceTab" type="button">
            <i class="bi bi-table me-1"></i> Balance
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link position-relative" data-bs-toggle="tab" data-bs-target="#pendingTab" type="button">
            <i class="bi bi-hourglass-split me-1"></i> Pending Replenishment
            <% if (pending.length > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.65rem">
                <%= pending.length %>
              </span>
            <% } %>
          </button>
        </li>
      </ul>

      <div class="tab-content px-3 pt-3">

        <!-- ── Balance Tab ─────────────────────────────────────── -->
        <div class="tab-pane fade show active" id="balanceTab" role="tabpanel">
          <div class="row g-2 mb-3 align-items-end">
            <div class="col-md-4 col-12">
              <label class="form-label small text-muted mb-1">กรอง FSE</label>
              <select id="fseFilter" class="form-select form-select-sm">
                <option value="">แสดงทุก FSE</option>
                <% fses.forEach(f => { %>
                  <option value="<%= f.shortName %>"><%= f.shortName %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <% if (balanceRows.length === 0) { %>
            <div class="alert alert-info">ยังไม่มีข้อมูล Mini Stock — เริ่มต้นด้วยการโอนของจาก Shelf</div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm" id="balanceTable">
              <thead class="table-dark">
                <tr>
                  <th class="text-center">FSE</th>
                  <th>SKU</th>
                  <th>Description</th>
                  <th class="text-center">Balance</th>
                </tr>
              </thead>
              <tbody>
                <% balanceRows.forEach(row => { %>
                <tr data-fse="<%= row.fse %>">
                  <td class="text-center"><span class="fse-tag" data-fse="<%= row.fse %>"><span class="fse-dot"></span><%= row.fse %></span></td>
                  <td class="text-start"><%= row.sku %></td>
                  <td class="text-start" style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="<%= row.description %>">
                    <%= row.description %>
                  </td>
                  <td class="text-center fw-semibold <%= row.qty < 0 ? 'text-danger' : '' %>"><%= row.qty %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ── Pending Tab ─────────────────────────────────────── -->
        <div class="tab-pane fade" id="pendingTab" role="tabpanel">
          <% if (pending.length === 0) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>ไม่มีรายการรอ Replenish</div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
              <thead class="table-dark">
                <tr>
                  <th class="text-center">วันที่</th>
                  <th class="text-center">FSE</th>
                  <th>SKU</th>
                  <th>Description</th>
                  <th class="text-center">Qty ใช้</th>
                  <th>Work Order</th>
                  <th class="text-center">On Shelf</th>
                  <th class="text-center">Action</th>
                </tr>
              </thead>
              <tbody>
                <% pending.forEach(p => {
                     const d = new Date(p.createdAt);
                     const dateStr = d.toLocaleDateString('th-TH', { year:'numeric', month:'short', day:'numeric', timeZone:'Asia/Bangkok' });
                     const canReplenish = p.shelfQty >= p.quantity;
                %>
                <tr>
                  <td class="text-center text-nowrap small"><%= dateStr %></td>
                  <td class="text-center"><span class="fse-tag" data-fse="<%= p.fse %>"><span class="fse-dot"></span><%= p.fse %></span></td>
                  <td class="text-start text-nowrap"><%= p.sku %></td>
                  <td class="text-start" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="<%= p.description %>">
                    <%= p.description %>
                  </td>
                  <td class="text-center fw-semibold"><%= p.quantity %></td>
                  <td class="text-nowrap small"><%= p.workOrderId || '-' %></td>
                  <td class="text-center <%= canReplenish ? 'shelf-ok' : 'shelf-low' %>" title="จำนวนบน Shelf">
                    <%= p.shelfQty %>
                    <% if (!canReplenish) { %><i class="bi bi-exclamation-triangle ms-1" title="ของไม่พอ"></i><% } %>
                  </td>
                  <td class="text-center">
                    <button class="btn btn-sm btn-success btn-replenish"
                      data-id="<%= p._id %>"
                      data-fse="<%= p.fse %>"
                      data-sku="<%= p.sku %>"
                      data-qty="<%= p.quantity %>"
                      data-wo="<%= p.workOrderId || '' %>"
                      data-desc="<%= (p.description || '').replace(/"/g, '&quot;') %>"
                      data-shelf="<%= p.shelfQty %>"
                      <%= canReplenish ? '' : 'disabled title="Shelf ไม่พอ"' %>>
                      Replenish
                    </button>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

      </div><!-- tab-content -->
    </div><!-- col -->
  </div><!-- row -->
</div><!-- container -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ── helpers ──────────────────────────────────────────────────
  function showAlert(type, text, timeout = 3000) {
    const wrap = document.getElementById('alertWrap');
    wrap.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show">
      ${text}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
    if (timeout) setTimeout(() => wrap.innerHTML = '', timeout);
  }

  function showAlertIn(id, type, text, timeout = 3000) {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show mb-2">
      ${text}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
    if (timeout) setTimeout(() => el.innerHTML = '', timeout);
  }

  async function fetchJSON(url, opts = {}) {
    const res = await fetch(url, { headers: { 'Content-Type': 'application/json' }, ...opts });
    let data = {};
    try { data = await res.json(); } catch(e) {}
    if (!res.ok || data.ok === false) throw new Error(data.message || res.statusText || 'เกิดข้อผิดพลาด');
    return data;
  }

  // ── Balance filter ────────────────────────────────────────────
  document.getElementById('fseFilter').addEventListener('change', function () {
    const val = this.value;
    document.querySelectorAll('#balanceTable tbody tr').forEach(tr => {
      tr.style.display = (!val || tr.dataset.fse === val) ? '' : 'none';
    });
  });

  // ── Transfer: show shelf qty when SKU changes ─────────────────
  document.getElementById('tfSKU').addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    const shelf = opt.getAttribute('data-shelf');
    const infoEl = document.getElementById('tfShelfInfo');
    if (shelf !== null) {
      infoEl.textContent = `On Shelf: ${shelf} ชิ้น`;
      infoEl.className = Number(shelf) > 0 ? 'shelf-ok small mb-3' : 'shelf-low small mb-3';
    } else {
      infoEl.textContent = '';
    }
  });

  // ── Transfer save ─────────────────────────────────────────────
  document.getElementById('btnTransferSave').addEventListener('click', async function () {
    const fse = document.getElementById('tfFSE').value;
    const sku = document.getElementById('tfSKU').value;
    const qty = document.getElementById('tfQty').value;
    const note = document.getElementById('tfNote').value;

    if (!fse || !sku || !qty) {
      return showAlertIn('transferAlert', 'warning', 'กรุณากรอกข้อมูลให้ครบ');
    }
    this.disabled = true;
    try {
      const res = await fetchJSON('/api/mini-stock/transfer', {
        method: 'POST',
        body: JSON.stringify({ fse, sku, quantity: qty, note })
      });
      bootstrap.Modal.getInstance(document.getElementById('transferModal')).hide();
      showAlert('success', res.message);
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      showAlertIn('transferAlert', 'danger', err.message);
    } finally {
      this.disabled = false;
    }
  });

  // ── Replenish ─────────────────────────────────────────────────
  let _replenishTarget = null;

  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.btn-replenish');
    if (!btn || btn.disabled) return;

    const { id, fse, sku, qty, wo, desc, shelf } = btn.dataset;
    _replenishTarget = { id, btn };

    document.getElementById('rpFSE').textContent  = fse;
    document.getElementById('rpSKU').textContent  = sku;
    document.getElementById('rpDesc').textContent = desc || '-';
    document.getElementById('rpQty').textContent  = qty;
    document.getElementById('rpWO').textContent   = wo || '-';

    const shelfNum = parseInt(shelf ?? btn.closest('tr')?.querySelector('.shelf-ok, .shelf-low')?.textContent ?? 0, 10);
    const shelfEl = document.getElementById('rpShelf');
    shelfEl.textContent = shelfNum + ' ชิ้น';
    shelfEl.className = shelfNum >= parseInt(qty, 10) ? 'text-success fw-semibold' : 'text-danger fw-semibold';

    bootstrap.Modal.getOrCreateInstance(document.getElementById('replenishModal')).show();
  });

  document.getElementById('btnReplenishConfirm').addEventListener('click', async function () {
    if (!_replenishTarget) return;
    const { id, btn } = _replenishTarget;

    this.disabled = true;
    btn.disabled = true;
    bootstrap.Modal.getInstance(document.getElementById('replenishModal')).hide();

    try {
      const res = await fetchJSON(`/api/mini-stock/replenish/${id}`, { method: 'POST' });
      showAlert('success', res.message);
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      showAlert('danger', err.message);
      btn.disabled = false;
    } finally {
      this.disabled = false;
      _replenishTarget = null;
    }
  });

  // ── FSE dot colors ───────────────────────────────────────────
  (function () {
    const PALETTE = ['#5b8dee','#e0634a','#3daf7f','#a665c8','#d4903a','#4db8c4','#c45f8a','#7d8f3e'];
    const fseColorMap = {};
    let idx = 0;
    document.querySelectorAll('.fse-tag').forEach(tag => {
      const name = tag.dataset.fse;
      if (!fseColorMap[name]) fseColorMap[name] = PALETTE[idx++ % PALETTE.length];
      tag.querySelector('.fse-dot').style.backgroundColor = fseColorMap[name];
    });
  })();

  // ── Reset transfer modal on close ────────────────────────────
  document.getElementById('transferModal').addEventListener('hidden.bs.modal', () => {
    document.getElementById('tfFSE').value = '';
    document.getElementById('tfSKU').value = '';
    document.getElementById('tfQty').value = 1;
    document.getElementById('tfNote').value = '';
    document.getElementById('tfShelfInfo').textContent = '';
    document.getElementById('transferAlert').innerHTML = '';
  });
</script>
</body>
</html>
